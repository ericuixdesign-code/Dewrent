modules = ["nodejs-20"]
run = "npm run dev"
entrypoint = "src/main.tsx"
hidden = [".config", "package-lock.json"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]
deploymentTarget = "static"
publicDir = "dist"

[[ports]]
localPort = 5173
externalPort = 80
